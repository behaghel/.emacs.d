@@ -0,0 +1,36 @@
+package daemon
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestEmmsPrivateAPI(t *testing.T) {
+	for _, c := range []struct {
+		key, header, method, path string
+		want int
+	}{
+		{"", "", "GET", "/", 403},
+		{"synthetic", "", "GET", "/auth/code", 403},
+		{"synthetic", "wrong", "GET", "/events", 403},
+		{"synthetic", "synthetic", "GET", "/", 204},
+		{"synthetic", "synthetic", "GET", "/events", 204},
+		{"synthetic", "synthetic", "POST", "/player/play", 204},
+		{"synthetic", "synthetic", "POST", "/token", 404},
+		{"synthetic", "synthetic", "POST", "/player/next", 404},
+		{"synthetic", "synthetic", "POST", "/library/liked", 404},
+	}{
+		t.Setenv("EMMS_SPOTIFY_API_KEY", c.key)
+		handler := emmsPrivateAPI(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(204)
+		}))
+		r := httptest.NewRequest(c.method, c.path, nil)
+		r.Header.Set("X-Emacs-Spotify-Key", c.header)
+		w := httptest.NewRecorder()
+		handler.ServeHTTP(w, r)
+		if w.Code != c.want {
+			t.Fatalf("%s %s: status %d, want %d", c.method, c.path, w.Code, c.want)
+		}
+	}
+}
