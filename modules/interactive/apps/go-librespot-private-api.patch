@@ -0,0 +1,27 @@
+package daemon
+
+import (
+	"crypto/subtle"
+	"net/http"
+	"os"
+)
+
+func emmsPrivateAPI(next http.Handler) http.Handler {
+	key := os.Getenv("EMMS_SPOTIFY_API_KEY")
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if key == "" || subtle.ConstantTimeCompare([]byte(key), []byte(r.Header.Get("X-Emacs-Spotify-Key"))) != 1 {
+			http.Error(w, "Receiver authentication required", http.StatusForbidden)
+			return
+		}
+		switch r.Method + " " + r.URL.Path {
+		case "GET /", "GET /auth/code", "GET /events",
+			"POST /player/play", "POST /player/stop",
+			"POST /player/pause", "POST /player/resume",
+			"POST /player/seek", "POST /player/repeat_context",
+			"POST /player/repeat_track", "POST /player/shuffle_context":
+			next.ServeHTTP(w, r)
+		default:
+			http.NotFound(w, r)
+		}
+	})
+}
