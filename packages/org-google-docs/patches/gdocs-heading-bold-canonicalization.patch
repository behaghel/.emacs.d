From acb92801d9d26b507fea484d5ab3e857db27f8e9 Mon Sep 17 00:00:00 2001
From: Hubert Behaghel <behaghel@gmail.com>
Date: Thu, 12 Nov 2026 11:43:09 +0100
Subject: [PATCH] Canonicalize uniform heading bold on import

Treat uniform bold across fetched headings as presentation while retaining contrasting partial bold, italic, and ordinary body emphasis. Avoid introducing whole-title Org markup from heading typography.

Add regression coverage across heading levels 1-6 and emphasis controls. All 179 converter tests pass. Live Google conformance remains unperformed.
---
 gdocs-convert.el           | 21 ++++++++++++++--
 test/gdocs-convert-test.el | 49 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 68 insertions(+), 2 deletions(-)

diff --git a/gdocs-convert.el b/gdocs-convert.el
index 27f7c8e..32b801f 100644
--- a/gdocs-convert.el
+++ b/gdocs-convert.el
@@ -2625,8 +2625,21 @@ MARKERS may contain original Org source ownership metadata."
                        (> marker-end start))))
               markers))
 
+(defun gdocs-convert--normalize-heading-bold (runs)
+  "Treat uniform heading bold in RUNS as presentation, not inline emphasis.
+Keep contrasting partial bold and all other inline formatting.  Ignore plain
+whitespace runs introduced by text-run normalization when checking uniformity."
+  (let ((visible (seq-filter
+                  (lambda (run)
+                    (not (string-blank-p (or (plist-get run :text) ""))))
+                  runs)))
+    (if (and visible (seq-every-p (lambda (run) (plist-get run :bold)) visible))
+        (gdocs-convert--merge-adjacent-runs
+         (mapcar (lambda (run) (plist-put (copy-sequence run) :bold nil)) runs))
+      runs)))
+
 (defun gdocs-convert--docs-paragraph-to-ir (paragraph lists-map markers
-                                                     &optional start end)
+                                                      &optional start end)
   "Convert a Google Docs PARAGRAPH to an IR element.
 LISTS-MAP is the document lists property.  MARKERS is parsed
 named-range marker data.  START and END are document indices."
@@ -2641,10 +2654,14 @@ named-range marker data.  START and END are document indices."
          (list-info (when bullet
                       (gdocs-convert--docs-bullet-to-list
                        bullet lists-map markers start end style-obj)))
+         (contents (if (and (not list-info)
+                            (gdocs-convert--heading-style-p ir-style))
+                       (gdocs-convert--normalize-heading-bold trimmed)
+                     trimmed))
          (ir-alignment (gdocs-convert--docs-alignment-to-ir alignment)))
     (append (list :type 'paragraph
                   :style (if list-info 'normal ir-style)
-                  :contents (or trimmed nil)
+                  :contents contents
                   :id (gdocs-convert--next-id))
             (unless list-info
               (when-let* ((style-name
diff --git a/test/gdocs-convert-test.el b/test/gdocs-convert-test.el
index d9c805e..911a28b 100644
--- a/test/gdocs-convert-test.el
+++ b/test/gdocs-convert-test.el
@@ -22,6 +22,17 @@
                 (or (null style) (eq (plist-get it :style) style)))
            ir))
 
+(defun gdocs-convert-test--render-docs-heading (level elements)
+  "Render a fetched heading at LEVEL with JSON paragraph ELEMENTS."
+  (gdocs-convert-ir-to-org
+   (gdocs-convert-docs-json-to-ir
+    (json-parse-string
+     (format (concat "{\"body\":{\"content\":[{\"paragraph\":{"
+                     "\"paragraphStyle\":{\"namedStyleType\":\"HEADING_%d\"},"
+                     "\"elements\":[%s]}}]}}")
+             level elements)
+     :object-type 'alist :false-object :json-false))))
+
 ;; ---------------------------------------------------------------------------
 ;;; Basic paragraph
 
@@ -51,6 +62,44 @@
       (should (eq (plist-get elem :style-name)
                   (intern (format "gdocs-heading-%d" level)))))))
 
+(ert-deftest gdocs-convert-test-docs-headings-do-not-wrap-titles-in-bold ()
+  "Fetched heading presentation does not create whole-title Org bold markup."
+  (dolist (level '(1 2 3 4 5 6))
+    (let* ((elements (format (concat "{\"textRun\":{\"content\":\"Section %d\\n\","
+                                     "\"textStyle\":{\"bold\":%s}}}")
+                             level (if (>= level 3) "true" "false")))
+           (result (gdocs-convert-test--render-docs-heading level elements)))
+      (should (equal result (format "%s Section %d\n" (make-string level ?*) level))))))
+
+(ert-deftest gdocs-convert-test-docs-headings-preserve-contrasting-italic ()
+  "Removing whole-heading bold must retain independently visible italic text."
+  (let ((elements
+         (concat "{\"textRun\":{\"content\":\"Alpha \",\"textStyle\":{\"bold\":true}}},"
+                 "{\"textRun\":{\"content\":\"careful\",\"textStyle\":{\"bold\":true,\"italic\":true}}},"
+                 "{\"textRun\":{\"content\":\" heading\\n\",\"textStyle\":{\"bold\":true}}}")))
+    (should (equal (gdocs-convert-test--render-docs-heading 3 elements)
+                   "*** Alpha /careful/ heading\n"))))
+
+(ert-deftest gdocs-convert-test-docs-headings-preserve-partial-bold ()
+  "Bold contrasting with the rest of a fetched heading remains authored markup."
+  (let ((elements
+         (concat "{\"textRun\":{\"content\":\"Alpha \",\"textStyle\":{\"bold\":false}}},"
+                 "{\"textRun\":{\"content\":\"careful\",\"textStyle\":{\"bold\":true}}},"
+                 "{\"textRun\":{\"content\":\" heading\\n\",\"textStyle\":{\"bold\":false}}}")))
+    (should (equal (gdocs-convert-test--render-docs-heading 3 elements)
+                   "*** Alpha *careful* heading\n"))))
+
+(ert-deftest gdocs-convert-test-docs-body-keeps-uniform-bold ()
+  "Whole-paragraph bold in normal body text remains semantic Org emphasis."
+  (let* ((json (json-parse-string
+                (concat "{\"body\":{\"content\":[{\"paragraph\":{"
+                        "\"paragraphStyle\":{\"namedStyleType\":\"NORMAL_TEXT\"},"
+                        "\"elements\":[{\"textRun\":{\"content\":\"Bold body.\\n\","
+                        "\"textStyle\":{\"bold\":true}}}]}}]}}")
+                :object-type 'alist))
+         (result (gdocs-convert-ir-to-org (gdocs-convert-docs-json-to-ir json))))
+    (should (equal result "*Bold body.*\n"))))
+
 (ert-deftest gdocs-convert-test-heading-level-7-clamped ()
   "Heading level 7+ is clamped to heading-6."
   (let* ((ir (gdocs-convert-org-string-to-ir "******* Deep heading"))
