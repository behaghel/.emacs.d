 gdocs-convert.el           | 352 ++++++++++++++++++++++++++++---------
 gdocs-diff.el              | 150 ++++++++++++----
 gdocs-sync.el              |   4 +-
 test/gdocs-convert-test.el | 157 +++++++++++++++++
 test/gdocs-diff-test.el    |  64 +++++++
 test/gdocs-sync-test.el    |  71 ++++++++
