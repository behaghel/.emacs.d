diff --git a/test/gdocs-diff-status-test.el b/test/gdocs-diff-status-test.el
new file mode 100644
index 0000000..04712a7
--- /dev/null
+++ b/test/gdocs-diff-status-test.el
@@ -0,0 +1,83 @@
+;;; gdocs-diff-status-test.el --- Static status diff contracts -*- lexical-binding: t; -*-
+
+;;; Commentary:
+;; Atomic status diffing and provider marker lifecycle are tested separately.
+
+;;; Code:
+
+(require 'ert)
+(require 'gdocs-diff)
+
+(ert-deftest gdocs-status-diff-has-a-dedicated-module ()
+  "Status tokenization and provider marker cleanup live outside the dispatcher."
+  (dolist (function '(gdocs-diff--status-marker-delete-requests
+                      gdocs-diff--tokenize-status-runs))
+    (should (equal (file-name-base (symbol-file function 'defun))
+                   "gdocs-diff-status"))))
+
+(ert-deftest gdocs-diff-test-status-colour-change-is-not-a-noop ()
+  "Changing colour updates marker/style without deleting text or comment anchors."
+  (let* ((old (let ((ir (gdocs-convert-org-string-to-ir "Keep [[status:Green][Ready]] anchor.\n")))
+                (plist-put (seq-find (lambda (run) (plist-get run :status))
+                                     (plist-get (car ir) :contents))
+                           :status-marker-ids '("old-status-1"))
+                ir))
+         (new (gdocs-convert-org-string-to-ir "Keep [[status:Red][Ready]] anchor.\n"))
+         (requests (gdocs-diff-generate old new))
+         (deletion (seq-some (lambda (request) (alist-get 'deleteContentRange request)) requests))
+         (marker (seq-some (lambda (request) (alist-get 'createNamedRange request)) requests)))
+    (should requests)
+    (should (equal (car requests) '((deleteNamedRange . ((namedRangeId . "old-status-1"))))))
+    (should-not deletion)
+    (should-not (seq-some (lambda (request) (alist-get 'insertText request)) requests))
+    (should marker)
+    (should (string-suffix-p ":status:Red:1" (alist-get 'name marker)))
+    (should-not (gdocs-diff-generate new new))))
+
+(ert-deftest gdocs-diff-test-status-surrounding-edit-keeps-pill-and-anchor ()
+  "Ordinary edits do not delete an unchanged pill or duplicate its metadata."
+  (let* ((old (gdocs-convert-org-string-to-ir "Keep [[status:Green][Ready]] anchor.\n"))
+         (new (gdocs-convert-org-string-to-ir "Edit [[status:Green][Ready]] anchor.\n"))
+         (requests (gdocs-diff-generate old new))
+         (deletion (seq-some (lambda (request) (alist-get 'deleteContentRange request)) requests)))
+    (should (equal (alist-get 'range deletion) '((startIndex . 1) (endIndex . 5) (segmentId . ""))))
+    (should-not (seq-some (lambda (request) (alist-get 'createNamedRange request)) requests))))
+
+(ert-deftest gdocs-diff-test-status-removal-clears-generated-background ()
+  "Replacing a pill by plain text clears generated formatting and stale links."
+  (let* ((old (gdocs-convert-org-string-to-ir "Keep [[status:Green][Ready]] anchor.\n"))
+         (new (gdocs-convert-org-string-to-ir "Keep Ready anchor.\n"))
+         (requests (gdocs-diff-generate old new)))
+    (should requests)
+    (should (seq-some
+             (lambda (request)
+               (let ((update (alist-get 'updateTextStyle request)))
+                 (and (string-match-p "backgroundColor" (or (alist-get 'fields update) ""))
+                      (string-match-p "link" (or (alist-get 'fields update) ""))
+                      (not (alist-get 'backgroundColor (alist-get 'textStyle update))))))
+             requests))))
+
+(ert-deftest gdocs-diff-test-status-boundary-edit-does-not-rewrite-identical-text ()
+  "Moving status meaning within identical visible text changes ranges, not text."
+  (let* ((old (gdocs-convert-org-string-to-ir "A [[status:Green][Ready]] Ready.\n"))
+         (new (gdocs-convert-org-string-to-ir "A Ready [[status:Green][Ready]].\n")))
+    (plist-put (seq-find (lambda (run) (plist-get run :status)) (plist-get (car old) :contents))
+               :status-marker-ids '("old-boundary"))
+    (let* ((requests (gdocs-diff-generate old new))
+           (marker (seq-some (lambda (request) (alist-get 'createNamedRange request)) requests)))
+      (should (equal (car requests) '((deleteNamedRange . ((namedRangeId . "old-boundary"))))))
+      (should (equal (alist-get 'range marker) '((startIndex . 9) (endIndex . 14))))
+      (should-not (seq-some (lambda (request)
+                              (or (alist-get 'insertText request) (alist-get 'deleteContentRange request)))
+                            requests)))))
+
+(ert-deftest gdocs-diff-test-status-paragraph-deletion-cleans-provider-marker-first ()
+  "Deleting a status paragraph removes its provider metadata before its text."
+  (let ((old (gdocs-convert-org-string-to-ir "[[status:Green][Ready]]\n")))
+    (plist-put (car (plist-get (car old) :contents)) :status-marker-ids '("deleted-status"))
+    (let ((requests (gdocs-diff-generate old nil)))
+      (should (equal (car requests) '((deleteNamedRange . ((namedRangeId . "deleted-status"))))))
+      (should (alist-get 'deleteContentRange (cadr requests))))))
+
+(provide 'gdocs-diff-status-test)
+;;; gdocs-diff-status-test.el ends here
diff --git a/test/gdocs-styles-test.el b/test/gdocs-styles-test.el
new file mode 100644
index 0000000..cb2364f
--- /dev/null
+++ b/test/gdocs-styles-test.el
@@ -0,0 +1,69 @@
+;;; gdocs-styles-test.el --- Presentation configuration contracts -*- lexical-binding: t; -*-
+
+;;; Commentary:
+;; Configuration loads without transport and changes rendering, not semantics.
+
+;;; Code:
+
+(require 'ert)
+(require 'cl-lib)
+
+(ert-deftest gdocs-styles-loads-without-conversion-or-transport ()
+  "Style configuration can be loaded on its own without the publishing client."
+  (let ((root (file-name-directory (directory-file-name
+                                    (file-name-directory (or load-file-name
+                                                             (locate-library "gdocs-styles-test")))))))
+    (with-temp-buffer
+      (should
+       (zerop
+        (process-file
+         (expand-file-name invocation-name invocation-directory) nil t nil
+         "--batch" "-Q" "-L" root "--eval"
+         "(progn (require 'gdocs-styles) (when (or (featurep 'gdocs-convert) (featurep 'gdocs-auth) (featurep 'gdocs-api)) (error \"Style configuration loaded transport/conversion\")))"))))))
+
+(ert-deftest gdocs-styles-heading-overrides-change-requests-not-ir ()
+  "Fonts, colours, and distances are supplied by configuration, not conversion."
+  (require 'gdocs-styles)
+  (require 'gdocs-convert)
+  (let* ((source "*** Plain heading\n")
+         (ir (gdocs-convert-org-string-to-ir source))
+         (before (copy-tree ir))
+         (gdocs-style-definitions
+          '((gdocs-heading-3 :parent heading-3
+                             :text (:font-family "Example Font" :foreground-color "#123456")
+                             :paragraph (:space-above 13 :space-below 9 :indent-start 17))))
+         (requests (gdocs-convert-ir-to-docs-requests ir))
+         (paragraph (cl-some
+                     (lambda (request)
+                       (let ((update (alist-get 'updateParagraphStyle request)))
+                         (when (alist-get 'spaceAbove (alist-get 'paragraphStyle update)) update)))
+                     requests))
+         (text (cl-some
+                (lambda (request)
+                  (let ((update (alist-get 'updateTextStyle request)))
+                    (when (alist-get 'weightedFontFamily (alist-get 'textStyle update)) update)))
+                requests)))
+    (should (equal ir before))
+    (should (equal (gdocs-convert-ir-to-org ir) source))
+    (should (equal (alist-get 'fontFamily
+                              (alist-get 'weightedFontFamily (alist-get 'textStyle text)))
+                   "Example Font"))
+    (should (alist-get 'foregroundColor (alist-get 'textStyle text)))
+    (should (= (alist-get 'magnitude (alist-get 'spaceAbove (alist-get 'paragraphStyle paragraph))) 13))
+    (should (= (alist-get 'magnitude (alist-get 'spaceBelow (alist-get 'paragraphStyle paragraph))) 9))
+    (should (= (alist-get 'magnitude (alist-get 'indentStart (alist-get 'paragraphStyle paragraph))) 17))))
+
+(ert-deftest gdocs-styles-border-fallbacks-are-configurable ()
+  "Fallback border colours, widths, and padding come from style configuration."
+  (require 'gdocs-styles)
+  (require 'gdocs-convert)
+  (let* ((gdocs-style-default-border-color "#123456")
+         (gdocs-style-default-border-width 3)
+         (gdocs-style-default-border-padding 7)
+         (border (gdocs-convert--paragraph-border-object nil nil nil)))
+    (should (equal (alist-get 'color border) (gdocs-convert--hex-to-color "#123456")))
+    (should (= (alist-get 'magnitude (alist-get 'width border)) 3))
+    (should (= (alist-get 'magnitude (alist-get 'padding border)) 7))))
+
+(provide 'gdocs-styles-test)
+;;; gdocs-styles-test.el ends here
diff --git a/test/gdocs-sync-status-test.el b/test/gdocs-sync-status-test.el
new file mode 100644
index 0000000..12239d8
--- /dev/null
+++ b/test/gdocs-sync-status-test.el
@@ -0,0 +1,86 @@
+;;; gdocs-sync-status-test.el --- Static status orchestration contracts -*- lexical-binding: t; -*-
+
+;;; Commentary:
+;; Offline push orchestration and callback context, not live API conformance.
+
+;;; Code:
+
+(require 'ert)
+(require 'cl-lib)
+(require 'gdocs-sync)
+(require 'gdocs-convert)
+(require 'gdocs-test-helpers)
+
+(ert-deftest gdocs-sync-test-status-conflicts-do-not-fall-back-to-text-merge ()
+  "A static status is semantic structure even in an otherwise plain paragraph."
+  (with-temp-buffer
+    (org-mode)
+    (insert "Local [[status:Green][Ready]].\n")
+    (should-error
+     (gdocs-sync--abort-unsafe-semantic-merge-if-needed
+      (gdocs-convert-org-string-to-ir "Remote [[status:Red][Ready]].\n"))
+     :type 'user-error)))
+
+(ert-deftest gdocs-sync-test-status-push-preserves-callback-source-and-provider-ids ()
+  "Initial and existing-document pushes use captured source/account state."
+  (dolist (existing '(nil t))
+    (let* ((source (generate-new-buffer " *status-push-source*"))
+           (other (generate-new-buffer " *status-push-callback*"))
+           (directory (make-temp-file "gdocs-status-push-" t))
+           (gdocs-directory directory)
+           (gdocs-link-directories nil)
+           (gdocs-preserve-comments nil)
+           fetch-callback sent-requests
+           (fetches 0) (writes 0)
+           (json (json-parse-string
+                  (if existing
+                      (concat "{\"body\":{\"content\":[{\"startIndex\":1,\"endIndex\":20,"
+                              "\"paragraph\":{\"elements\":[{\"startIndex\":1,\"endIndex\":20,"
+                              "\"textRun\":{\"content\":\"Keep Ready anchor.\\n\"}}]}}]},"
+                              "\"namedRanges\":{\"gdocs-org-marker:status:run-6:status:Green:1\":{"
+                              "\"namedRanges\":[{\"namedRangeId\":\"old-marker\",\"ranges\":[{\"startIndex\":6,\"endIndex\":11}]}]}}}")
+                    "{\"body\":{\"content\":[{\"startIndex\":1,\"endIndex\":2,\"paragraph\":{\"elements\":[{\"textRun\":{\"content\":\"\\n\"}}]}}]}}")
+                  :object-type 'alist)))
+      (unwind-protect
+          (cl-letf (((symbol-function 'gdocs-api-get-document)
+                     (lambda (id callback &optional account _error)
+                       (should (equal id "status-doc"))
+                       (should (equal account "status-account"))
+                       (cl-incf fetches)
+                       (setq fetch-callback callback)))
+                    ((symbol-function 'gdocs-api-batch-update)
+                     (lambda (id requests callback &optional account _error)
+                       (should (eq (current-buffer) source))
+                       (should (equal id "status-doc"))
+                       (should (equal account "status-account"))
+                       (cl-incf writes)
+                       (setq sent-requests requests)
+                       (funcall callback '((writeControl . ((requiredRevisionId . "status-r2"))))))))
+            (with-current-buffer source
+              (org-mode)
+              (insert "Keep [[status:Red][Ready]] anchor.\n")
+              (setq-local gdocs-sync--document-id "status-doc")
+              (setq-local gdocs-sync--account "status-account")
+              (gdocs-sync-push)
+              (should (= writes 0)))
+            (with-current-buffer other (funcall fetch-callback json))
+            (should (= writes 1))
+            (should (seq-some (lambda (request) (alist-get 'createNamedRange request)) sent-requests))
+            (when existing
+              (should (equal (car sent-requests)
+                             '((deleteNamedRange . ((namedRangeId . "old-marker")))))))
+            (with-current-buffer source
+              (should (eq gdocs-sync--status 'synced))
+              (should (equal gdocs-sync--revision-id "status-r2"))
+              (should-not gdocs-sync--push-in-progress)
+              (gdocs-sync-push))
+            (should (= fetches 1))
+            (should (= writes 1)))
+        (dolist (buffer (list source other))
+          (when (buffer-live-p buffer)
+            (with-current-buffer buffer (set-buffer-modified-p nil))
+            (kill-buffer buffer)))
+        (delete-directory directory t)))))
+
+(provide 'gdocs-sync-status-test)
+;;; gdocs-sync-status-test.el ends here
