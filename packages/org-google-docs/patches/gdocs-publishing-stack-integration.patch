+*** Static status labels
+:PROPERTIES:
+:CUSTOM_ID: h:static-status-labels
+:END:
+
+Plain links such as ~[[status:Green][Ready]]~ publish as static coloured
+labels, not colour URLs.  The existing authoring spelling
+~[[confluence-status:Green][Ready]]~ is also accepted and retained on pull.
+Colours are Grey (or Gray), Red, Yellow, Green, Blue, and Purple, matched
+case-insensitively.  Source colour spelling and label text remain intact.
+
+Status runs carry ~:status~ metadata with ~:link-type~, ~:color~, and
+~:described~.  Text styling supplies a neutral background/foreground pair;
+~gdocs-status-COLOR~ entries in ~gdocs-style-definitions~ can override it.
+Semantic named ranges preserve status identity independently of text-run
+splits and styling.  Remote label edits retain the colour and link spelling.
+Provider range IDs are transient diff metadata, not authored Org data.
+
+These labels are not native Google dropdowns.  A static Org status does not
+declare a choice set, so publishing does not invent selectable options.
+Rich labels, tables, footnotes, labels crossing paragraphs, and mixtures
+with native dates or footnotes in one paragraph fail closed.  Imported
+native dropdowns also require an explicit choice-set mapping and are rejected.
+
+Status diffs keep unchanged labels and surrounding text in place.  Colour-only
+changes update styles and semantic ranges without deleting text; removed or
+changed markers are deleted by provider ID before content changes.  A
+simultaneous local/remote status conflict does not fall back to plain-text merge.
+
+Already-published bogus colour URLs are not guessed back into statuses.
+Restore the intended Org status links from a known-good source or backup
+before republishing.  Offline fixtures cover conversion, Unicode ranges,
+provider-run normalization, repeat diffs, and callback source/account handling;
+they do not establish live Google rendering or API conformance.
+
 ** Diff engine
 :PROPERTIES:
 :CUSTOM_ID: h:diff-functions
diff --git a/gdocs-convert-headings.el b/gdocs-convert-headings.el
new file mode 100644
index 0000000..faa6ff9
--- /dev/null
+++ b/gdocs-convert-headings.el
@@ -0,0 +1,118 @@
+;;; gdocs-convert-headings.el --- Heading semantics and canonicalization -*- lexical-binding: t; -*-
+
+;; Copyright (C) 2026 Pablo Stafforini
+
+;;; Commentary:
+;; Org and Docs heading conversion.  Presentation comes from gdocs-styles;
+;; heading levels, metadata, and visible inline semantics are conversion rules.
+;; Shared run and marker helpers are supplied by the gdocs-convert dispatcher.
+
+;;; Code:
+
+(require 'org)
+(require 'org-element)
+(require 'seq)
+(require 'subr-x)
+
+(declare-function gdocs-convert--objects-to-runs "gdocs-convert" (objects &optional inherited-props))
+(declare-function gdocs-convert--next-id "gdocs-convert" ())
+(declare-function gdocs-convert--extract-marker-field "gdocs-convert" (marker type-sym))
+(declare-function gdocs-convert--merge-adjacent-runs "gdocs-convert" (runs))
+
+(defun gdocs-convert--headline-to-ir (headline)
+  "Convert an org HEADLINE element to an IR element."
+  (let* ((level (org-element-property :level headline))
+         (style (gdocs-convert--level-to-style level))
+         (title-objects (org-element-property :title headline))
+         (contents (gdocs-convert--objects-to-runs title-objects))
+         (marker (gdocs-convert--headline-marker headline)))
+    (append (list :type 'paragraph
+                  :style style
+                  :style-name (gdocs-convert--heading-logical-style-name style)
+                  :contents contents
+                  :id (gdocs-convert--next-id))
+            (when marker (list :gdocs-marker marker)))))
+
+(defun gdocs-convert--heading-logical-style-name (style)
+  "Return logical Google Docs style name for heading STYLE."
+  (intern (format "gdocs-%s" style)))
+
+(defun gdocs-convert--level-to-style (level)
+  "Convert an org heading LEVEL to an IR style, clamped to heading-6."
+  (intern (format "heading-%d" (min level 6))))
+
+(defun gdocs-convert--headline-marker (headline)
+  "Return preservable Org-only metadata from HEADLINE, or nil."
+  (let* ((todo (org-element-property :todo-keyword headline))
+         (tags (org-element-property :tags headline))
+         (priority (org-element-property :priority headline))
+         (scheduled (org-element-property :scheduled headline))
+         (deadline (org-element-property :deadline headline))
+         (parts nil))
+    (when deadline
+      (push (list :type 'deadline :data (org-element-interpret-data deadline)) parts))
+    (when scheduled
+      (push (list :type 'scheduled :data (org-element-interpret-data scheduled)) parts))
+    (when priority
+      (push (list :type 'priority :data (char-to-string priority)) parts))
+    (when tags
+      (push (list :type 'tags :data (string-join tags ":")) parts))
+    (when todo
+      (push (list :type 'todo :data todo) parts))
+    parts))
+
+(defun gdocs-convert--heading-style-p (style)
+  "Return non-nil if STYLE is a heading style."
+  (and style (string-prefix-p "heading-" (symbol-name style))))
+
+(defun gdocs-convert--heading-docs-to-style (named-style)
+  "Return a heading IR style for Docs NAMED-STYLE, or nil."
+  (let ((case-fold-search nil))
+    (when (and named-style (string-match "\\`HEADING_\\([1-6]\\)\\'" named-style))
+      (intern (concat "heading-" (match-string 1 named-style))))))
+
+(defun gdocs-convert--heading-style-to-docs (style)
+  "Return the Docs named heading style for IR STYLE, or nil."
+  (let ((case-fold-search nil))
+    (when (and style (string-match "\\`heading-\\([1-6]\\)\\'" (symbol-name style)))
+      (concat "HEADING_" (match-string 1 (symbol-name style))))))
+
+(defun gdocs-convert--format-heading (style text marker)
+  "Format a heading with STYLE, TEXT, and optional Org-only MARKER data."
+  (let* ((level (string-to-number (substring (symbol-name style) (length "heading-"))))
+         (stars (make-string level ?*))
+         (todo (gdocs-convert--extract-marker-field marker 'todo))
+         (tags (gdocs-convert--extract-marker-field marker 'tags))
+         (priority (gdocs-convert--extract-marker-field marker 'priority))
+         (head (concat stars " " (when todo (concat todo " "))
+                       (when priority (format "[#%s] " priority)) text))
+         (scheduled (gdocs-convert--extract-marker-field marker 'scheduled))
+         (deadline (gdocs-convert--extract-marker-field marker 'deadline))
+         (planning-parts nil))
+    (when deadline (push (format "DEADLINE: %s" deadline) planning-parts))
+    (when scheduled (push (format "SCHEDULED: %s" scheduled) planning-parts))
+    (let ((heading (if tags (gdocs-convert--heading-with-tags head tags) head)))
+      (if planning-parts
+          (concat heading "\n" (string-join planning-parts " "))
+        heading))))
+
+(defun gdocs-convert--heading-with-tags (head tags-string)
+  "Format HEAD with TAGS-STRING in Org syntax."
+  (format "%s :%s:" head tags-string))
+
+(defun gdocs-convert--normalize-heading-bold (runs)
+  "Treat uniform heading bold in RUNS as presentation, not inline emphasis.
+Keep contrasting partial bold and all other inline formatting.  Ignore plain
+whitespace runs introduced by text-run normalization when checking uniformity."
+  (let ((visible (seq-filter
+                  (lambda (run)
+                    (and (not (plist-get run :status))
+                         (not (string-blank-p (or (plist-get run :text) "")))))
+                  runs)))
+    (if (and visible (seq-every-p (lambda (run) (plist-get run :bold)) visible))
+        (gdocs-convert--merge-adjacent-runs
+         (mapcar (lambda (run) (plist-put (copy-sequence run) :bold nil)) runs))
+      runs)))
+
+(provide 'gdocs-convert-headings)
+;;; gdocs-convert-headings.el ends here
diff --git a/gdocs-convert-status.el b/gdocs-convert-status.el
new file mode 100644
index 0000000..ccd96de
--- /dev/null
+++ b/gdocs-convert-status.el
@@ -0,0 +1,157 @@
+;;; gdocs-convert-status.el --- Static status label conversion -*- lexical-binding: t; -*-
+
+;; Copyright (C) 2026 Pablo Stafforini
+
+;;; Commentary:
+;; Status labels carry colour identifiers and plain text, not dropdown options.
+;; Presentation defaults live in gdocs-styles.  Shared run and index helpers
+;; are supplied by gdocs-convert, without a circular require on the dispatcher.
+
+;;; Code:
+
+(require 'cl-lib)
+(require 'org-element)
+(require 'seq)
+(require 's)
+(require 'subr-x)
+(require 'gdocs-styles)
+
+(declare-function gdocs-convert--logical-text-style-to-docs "gdocs-convert" (style-plist))
+(declare-function gdocs-convert--text-range "gdocs-convert" (start end &optional segment-id))
+(declare-function gdocs-convert--make-plain-run "gdocs-convert" (text))
+(declare-function gdocs-convert--docs-text-run-to-ir "gdocs-convert" (text-run))
+(declare-function gdocs-convert--string-to-utf16-length "gdocs-convert" (string))
+
+(defun gdocs-convert--status-docs-style (status)
+  "Return the Docs text style for semantic STATUS."
+  (let* ((key (gdocs-convert--status-color-key (plist-get status :color)))
+         (definition (assq (intern (concat "gdocs-status-" key)) gdocs-style-definitions)))
+    (gdocs-convert--logical-text-style-to-docs
+     (if definition (plist-get (cdr definition) :text)
+       (cdr (assq (intern key) gdocs-status-default-styles))))))
+
+(defun gdocs-convert--status-marker-request (status start end &optional segment-id)
+  "Return the semantic STATUS marker covering START to END.
+SEGMENT-ID must be nil; status labels inside footnotes are unsupported."
+  (when segment-id (user-error "Status labels inside document segments are unsupported"))
+  `((createNamedRange
+     . ((name . ,(format "gdocs-org-marker:status:run-%d:%s:%s:%d"
+                         start (plist-get status :link-type) (plist-get status :color)
+                         (if (plist-get status :described) 1 0)))
+        (range . ,(gdocs-convert--text-range start end))))))
+
+(defun gdocs-convert--status-color-key (color)
+  "Return the supported logical status key for COLOR, or signal an error."
+  (let ((key (downcase (or color ""))))
+    (when (equal key "gray") (setq key "grey"))
+    (unless (member key '("grey" "red" "yellow" "green" "blue" "purple"))
+      (user-error "Unsupported status colour `%s'" color))
+    key))
+
+(defun gdocs-convert--status-link-to-run (link inherited-props)
+  "Convert a static status LINK to a semantic run, or return nil.
+Reject rich labels and unsupported contexts instead of making a colour URL.
+INHERITED-PROPS must not add invisible emphasis to the generated pill style."
+  (let ((raw (org-element-property :raw-link link))
+        (case-fold-search t))
+    (when (and raw (string-match "\\`\\(status\\|confluence-status\\):\\(.*\\)\\'" raw))
+      (let* ((protocol (match-string 1 raw))
+             (color (match-string 2 raw))
+             (children (org-element-contents link))
+             (label (substring-no-properties
+                     (if children (apply #'concat (seq-filter #'stringp children)) color)))
+             (container (org-element-lineage link '(paragraph headline))))
+        (gdocs-convert--status-color-key color)
+        (when (or (not (seq-every-p #'stringp children))
+                  (seq-some (lambda (key) (plist-get inherited-props key))
+                            '(:bold :italic :underline :strikethrough :code :subscript :superscript))
+                  (org-element-lineage link '(table footnote-definition footnote-reference)))
+          (user-error "Status labels support plain body/list/heading text only; no rich label, table, or footnote"))
+        (when (and container
+                   (org-element-map
+                    (if (eq (org-element-type container) 'headline)
+                        (org-element-property :title container) container)
+                    '(timestamp footnote-reference) #'identity nil t))
+          (user-error "Status labels mixed with native dates or footnotes in one paragraph are unsupported"))
+        (when (or (string-blank-p label) (string-match-p "[\n\r]" label))
+          (user-error "A status label must be nonempty and stay in one paragraph"))
+        (plist-put (gdocs-convert--make-plain-run label) :status
+                   (list :link-type protocol :color color :described (not (null children))))))))
+
+(defun gdocs-convert--status-run-to-org (run)
+  "Render semantic status RUN using its original link spelling and label."
+  (let* ((status (plist-get run :status))
+         (target (format "%s:%s" (plist-get status :link-type) (plist-get status :color)))
+         (text (plist-get run :text)))
+    (when (or (not (stringp text)) (string-blank-p text)
+              (string-match-p "[\n\r]\\|\\]\\]" text))
+      (user-error "Status label cannot be represented as a single plain Org link description"))
+    (if (or (plist-get status :described)
+            (not (equal text (plist-get status :color))))
+        (format "[[%s][%s]]" target text)
+      (format "[[%s]]" target))))
+
+(defun gdocs-convert--status-marker-data (marker)
+  "Decode and validate semantic status MARKER data."
+  (let* ((parts (s-split ":" (or (plist-get marker :data) "")))
+         (protocol (nth 0 parts)) (color (nth 1 parts)) (described (nth 2 parts)))
+    (unless (and (= (length parts) 3)
+                 (member (downcase protocol) '("status" "confluence-status"))
+                 (member described '("0" "1")))
+      (user-error "Invalid status marker metadata"))
+    (gdocs-convert--status-color-key color)
+    (list :link-type protocol :color color :described (equal described "1"))))
+
+(defun gdocs-convert--utf16-string-index (text units)
+  "Return the character index in TEXT at exactly UNITS UTF-16 code units."
+  (let ((index 0) (offset 0))
+    (while (and (< offset units) (< index (length text)))
+      (setq offset (+ offset (if (> (aref text index) #xFFFF) 2 1))
+            index (1+ index)))
+    (unless (= offset units)
+      (user-error "Status marker splits a Unicode character or exceeds its text"))
+    index))
+
+(defun gdocs-convert--docs-status-text-parts (element markers)
+  "Split text ELEMENT at semantic status MARKERS into (MARKER . RUN) pairs."
+  (let* ((run (gdocs-convert--docs-text-run-to-ir (alist-get 'textRun element)))
+         (text (plist-get run :text))
+         (start (or (alist-get 'startIndex element) 0))
+         (end (+ start (gdocs-convert--string-to-utf16-length text)))
+         (statuses (seq-filter
+                    (lambda (marker)
+                      (and (eq (plist-get marker :type) 'status)
+                           (< (plist-get marker :start) end)
+                           (> (plist-get marker :end) start))) markers)))
+    (if (null statuses)
+        (list (cons nil run))
+      (let* ((cuts (sort (delete-dups
+                          (append (list start end)
+                                  (cl-mapcan (lambda (marker)
+                                               (list (max start (plist-get marker :start))
+                                                     (min end (plist-get marker :end)))) statuses))) #'<))
+             (parts nil))
+        (while (cdr cuts)
+          (let* ((a (car cuts)) (b (cadr cuts))
+                 (covering (seq-filter (lambda (marker)
+                                         (and (<= (plist-get marker :start) a)
+                                              (>= (plist-get marker :end) b))) statuses))
+                 (marker (car covering))
+                 (value (substring text
+                                   (gdocs-convert--utf16-string-index text (- a start))
+                                   (gdocs-convert--utf16-string-index text (- b start))))
+                 (part (if marker (gdocs-convert--make-plain-run value)
+                         (plist-put (copy-sequence run) :text value))))
+            (when (> (length covering) 1)
+              (user-error "Overlapping status markers require manual review"))
+            (when marker
+              (when (string-match-p "[\n\r]" value)
+                (user-error "A status marker cannot cross paragraph boundaries"))
+              (plist-put part :status (gdocs-convert--status-marker-data marker))
+              (plist-put part :status-marker-ids (list (plist-get marker :range-id))))
+            (push (cons marker part) parts))
+          (setq cuts (cdr cuts)))
+        (nreverse parts)))))
+
+(provide 'gdocs-convert-status)
+;;; gdocs-convert-status.el ends here
