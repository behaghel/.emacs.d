From 590a2e4afdb873b0bd8a9eb41501d0df18aea723 Mon Sep 17 00:00:00 2001
From: Hubert Behaghel <behaghel@gmail.com>
Date: Fri, 13 Nov 2026 16:20:37 +0100
Subject: [PATCH] fix(ci): provision Compat and verify current semantic
 contracts

Clean source reproduction: full strict compilation and all 655 SDK tests pass. Provide Transient its Compat dependency, resolve compilation warnings without disabling checks, and replace four obsolete representation expectations with block round-trip/provider-marker and local AUTHOR metadata contracts. Adapter sandbox: 102 pass, 25 live skipped.
---
 .github/workflows/test.yml   |  1 +
 Makefile                     |  3 +-
 gdocs-api.el                 |  4 +-
 gdocs-convert.el             | 61 +++++++++++++++--------------
 gdocs-sync.el                |  2 +-
 test/gdocs-roundtrip-test.el | 75 ++++++++++++++++++++++++++----------
 6 files changed, 90 insertions(+), 56 deletions(-)

diff --git a/.github/workflows/test.yml b/.github/workflows/test.yml
index 533d9a7..71ac85b 100644
--- a/.github/workflows/test.yml
+++ b/.github/workflows/test.yml
@@ -24,6 +24,7 @@ jobs:
           git clone --depth 1 https://github.com/magit/transient.git ../transient
           git clone --depth 1 https://github.com/tarsius/cond-let.git ../cond-let
           git clone --depth 1 https://github.com/tarsius/llama.git ../llama
+          git clone --depth 1 https://github.com/emacs-straight/compat.git ../compat
       - name: Byte-compile
         run: make compile
       - name: Run tests
diff --git a/Makefile b/Makefile
index bc59626..1981cd6 100644
--- a/Makefile
+++ b/Makefile
@@ -7,7 +7,8 @@ LOAD_PATH := -L $(CURDIR) -L test \
              -L $(ELPACA_REPOS)transient/lisp \
              -L $(ELPACA_REPOS)cond-let \
              -L $(ELPACA_REPOS)seq \
-             -L $(ELPACA_REPOS)llama
+             -L $(ELPACA_REPOS)llama \
+             -L $(ELPACA_REPOS)compat
 
 TEST_FILES = \
   test/gdocs-test-helpers.el \
diff --git a/gdocs-api.el b/gdocs-api.el
index 7175456..ed5c754 100644
--- a/gdocs-api.el
+++ b/gdocs-api.el
@@ -223,12 +223,12 @@ Return a MIME type string based on the file extension."
       (_ (error "Unsupported image type: %s (supported: png, jpg, jpeg, gif, webp, svg)" ext)))))
 
 (defun gdocs-api--send-multipart-upload (token file-path mime-type
-                                               metadata callback account)
+                                               metadata callback _account)
   "Send a multipart upload request to Google Drive.
 TOKEN is the OAuth access token.  FILE-PATH is the local file.
 MIME-TYPE is the file's MIME type.  METADATA is the JSON metadata
 string.  CALLBACK receives the parsed JSON response.  ACCOUNT is
-the account name for error reporting."
+reserved for caller compatibility."
   ;; Multipart uploads are sent with curl directly instead of through `plz'.
   ;; `plz' feeds both its curl config and request body through stdin; Google
   ;; Drive intermittently treats larger binary multipart payloads sent this way
diff --git a/gdocs-convert.el b/gdocs-convert.el
index b0b85d3..2a3e5f1 100644
--- a/gdocs-convert.el
+++ b/gdocs-convert.el
@@ -913,9 +913,9 @@ heading cache and append a #heading=h.ID fragment."
 
 (defun gdocs-convert--timestamp-to-runs (timestamp inherited-props)
   "Convert TIMESTAMP to a native Google Docs date run.
-INHERITED-PROPS carries parent formatting.  The original Org timestamp syntax is
-kept as the run text so Org output can reconstruct the source form when the IR is
-not pushed to Google Docs."
+INHERITED-PROPS carries parent formatting.  The original Org timestamp
+syntax is kept as the run text so Org output can reconstruct the source
+form when the IR is not pushed to Google Docs."
   (let ((raw (org-element-interpret-data timestamp))
         (year (org-element-property :year-start timestamp))
         (month (org-element-property :month-start timestamp))
@@ -2783,6 +2783,18 @@ may have trailing whitespace-only runs before it."
       (list :type (intern type)
             :level (string-to-number level)))))
 
