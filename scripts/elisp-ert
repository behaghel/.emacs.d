#!/usr/bin/env bash
set -euo pipefail

export HOME=${HOME:-$PWD}

# Git hooks export the committing worktree's index.  Nested Git operations
# during package setup or tests must use their own repository's index instead.
# This affects test children only; the parent hook and Git configuration remain.
unset GIT_INDEX_FILE

# One inventory serves full runs, changed-path selection, and --list.
mapfile -t inventory < <(
  find test packages -type f -name '*-test.el' \
    \( -path 'test/*' -o -path 'packages/*/test/*' \) | LC_ALL=C sort
)

list_only=false
if [ "${1:-}" = "--list" ]; then
  list_only=true
  shift
fi

add_test() {
  local test_file="$1"
  if [ -f "$test_file" ]; then
    tests+=("$test_file")
  fi
}

add_all_tests() {
  tests+=("${inventory[@]}")
}

# Select a focused test set from changed paths.  With no paths, preserve the
# historical behavior and run the full ERT suite.
tests=()
if [ "$#" -eq 0 ]; then
  add_all_tests
else
  for path in "$@"; do
    case "$path" in
      test/test-helpers.el|scripts/elisp-ert)
        add_all_tests
        ;;
      test/**/*-test.el|test/*-test.el|packages/*/test/*-test.el)
        add_test "$path"
        ;;
      init.el|core/*.el|early-init.el)
        add_test test/configuration-system/smoke-test.el
        ;;
      modules/interactive/tools/blog.el)
        add_test test/publishing/blog/blog-integration-test.el
        ;;
      modules/interactive/navigation/perspective-auto.el)
        add_test test/interactive-foundation/navigation/perspective-auto-test.el
        ;;
      modules/interactive/video/eve.el)
        add_test test/personal-apps/video/eve-test.el
        ;;
      modules/interactive/notes/*|modules/interactive/org/*|modules/interactive/writing/*|lisp/hub-prose.el)
        add_test test/authoring/notes/denote-note-test.el
        add_test test/authoring/org/prose-wrapping-test.el
        ;;
      modules/org/export-latex.el|etc/latex/*|etc/latex/assets/*|lisp/hub-org-callout.el)
        add_test test/authoring/documents/org-export-test.el
        add_test test/authoring/documents/org-latex-pdf-export-test.el
        ;;
      packages/*)
        package="${path#packages/}"
        package="${package%%/*}"
        for test_file in "${inventory[@]}"; do
          case "$test_file" in
            "packages/$package/test/"*) add_test "$test_file" ;;
          esac
        done
        if [ "$package" = "org-confluence" ]; then
          add_test test/publishing/confluence/org-confluence-api-test.el
          add_test test/publishing/confluence/org-confluence-export-test.el
        fi
        ;;
      scripts/approval-refresh-overdrive-page1.el|scripts/export-demo-adaptive-cards.el)
        add_test test/authoring/documents/org-latex-pdf-export-test.el
        ;;
    esac
  done
fi

# Dedupe while preserving order.
if [ "${#tests[@]}" -gt 0 ]; then
  mapfile -t tests < <(printf '%s\n' "${tests[@]}" | awk '!seen[$0]++')
fi

# org-dropcap-test relies on the export-latex module loaded by the larger PDF
# export test file.  Keep focused test runs robust when pre-commit chunks test
# filenames and does not happen to include that dependency first.
if printf '%s\n' "${tests[@]}" | grep -qx 'test/authoring/org/org-dropcap-test.el' \
  && ! printf '%s\n' "${tests[@]}" | grep -qx 'test/authoring/documents/org-latex-pdf-export-test.el'; then
  tests=(test/authoring/documents/org-latex-pdf-export-test.el "${tests[@]}")
fi

if "$list_only"; then
  if [ "${#tests[@]}" -gt 0 ]; then
    printf '%s\n' "${tests[@]}"
  fi
  exit 0
fi

if [ "${#tests[@]}" -eq 0 ]; then
  echo "No related ERT tests selected."
  exit 0
fi

# Package suites and configuration tests may intentionally reuse ERT names or
# install different stubs.  Do not load them into the same Emacs process.
mapfile -t groups < <(
  printf '%s\n' "${tests[@]}" |
    awk -F/ '{ if ($1 == "packages") print $1 "/" $2; else print "test" }' |
    awk '!seen[$0]++'
)

echo "Selected ${#tests[@]} ERT files across ${#groups[@]} suites."
straight_build_path="${STRAIGHT_BUILD_PATH:-straight/build}"
context_panels_path="${CONTEXT_PANELS_PATH:-$straight_build_path/context-panels}"
if [ -n "${CONTEXT_PANELS_PATH:-}" ]; then
  for library in context-panels.el context-panels-org.el; do
    if [ ! -r "$context_panels_path/$library" ]; then
      printf 'CONTEXT_PANELS_PATH must contain readable %s: %s\n' \
        "$library" "$context_panels_path" >&2
      exit 1
    fi
  done
fi
context_panels_load_args=()
if [ -d "$context_panels_path" ]; then
  context_panels_load_args=("-L" "$context_panels_path")
fi
straight_load_args=()
for package in compat transient cond-let llama magit-section; do
  if [ -d "$straight_build_path/$package" ]; then
    straight_load_args+=("-L" "$straight_build_path/$package")
  fi
done

local_package_args=()
for package_dir in packages/*/; do
  local_package_args+=("-L" "$package_dir")
done

failed_groups=()
for group in "${groups[@]}"; do
  load_args=()
  for test_file in "${tests[@]}"; do
    case "$test_file" in
      "$group/"*) load_args+=("-l" "$test_file") ;;
    esac
  done
  echo "Running ERT suite: $group"
  if ! emacs --batch -Q \
    -L . \
    "${context_panels_load_args[@]}" \
    "${straight_load_args[@]}" \
    "${local_package_args[@]}" \
    -L lisp \
    -l ert -l test/test-helpers.el "${load_args[@]}" -f ert-run-tests-batch-and-exit; then
    failed_groups+=("$group")
  fi
done

if [ "${#failed_groups[@]}" -gt 0 ]; then
  echo "Failed ERT suites: ${failed_groups[*]}" >&2
  exit 1
fi

echo "All ${#groups[@]} ERT suites completed successfully; see ERT output for skips."
