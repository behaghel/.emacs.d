#!/usr/bin/env bash
# Exercise org-comments without this checkout's configuration or sibling packages.
set -euo pipefail

mode=${1:---batch}
if [ "$#" -gt 1 ] || { [ "$mode" != --batch ] && [ "$mode" != --interactive ]; }; then
  echo "Usage: $0 [--batch|--interactive]" >&2
  exit 64
fi

repo_root=$(cd "$(dirname "$0")/.." && pwd)
package_root="$repo_root/packages/org-comments"
context_panels_path=${CONTEXT_PANELS_PATH:-${STRAIGHT_BUILD_PATH:-$repo_root/straight/build}/context-panels}
for library in context-panels.el context-panels-org.el; do
  if [ ! -r "$context_panels_path/$library" ]; then
    echo "Set CONTEXT_PANELS_PATH to a directory containing $library." >&2
    exit 1
  fi
done

sandbox=$(mktemp -d "${TMPDIR:-/tmp}/org-comments-standalone.XXXXXX")
trap 'rm -rf "$sandbox"' EXIT
mkdir -p "$sandbox/org-comments/test" "$sandbox/context-panels" "$sandbox/home"
# Copy source only: no compiled libraries, personal state, or repository helpers.
cp "$package_root/"*.el "$sandbox/org-comments/"
cp "$package_root/test/"*-test.el "$sandbox/org-comments/test/"
cp "$context_panels_path/context-panels.el" \
  "$context_panels_path/context-panels-org.el" "$sandbox/context-panels/"
cd "$sandbox"
export HOME="$sandbox/home"
export XDG_CONFIG_HOME="$HOME/.config" XDG_CACHE_HOME="$HOME/.cache" XDG_DATA_HOME="$HOME/.local/share"
unset EMACSLOADPATH EMACSNATIVELOADPATH

args=(-Q -L "$sandbox/org-comments" -L "$sandbox/context-panels")
isolation='(progn
  (dolist (library (quote ("hub-utils" "test-helpers" "hb-static-site"
                          "org-copilot" "org-suggestions" "org-marginalia"
                          "org-sync" "org-confluence" "org-google-docs")))
    (when (locate-library library)
      (error "Unexpected ambient library: %s" library)))
  (advice-add (quote make-network-process) :override
              (lambda (&rest _) (error "Standalone checks do not use the network"))))'

if [ "$mode" = --interactive ]; then
  printf 'Alpha selected text omega.\n' > draft.org
  echo "Temporary standalone session; files are removed when Emacs exits."
  echo "Select 'selected text', M-x org-comments-create, write/save the sidecar."
  echo "Reopen draft.org, enable org-comments-mode, then M-x org-comments-open."
  emacs "${args[@]}" --eval "$isolation" draft.org \
    --eval '(progn (require (quote org-comments)) (org-comments-mode 1))'
else
  tests=()
  for test_file in "$sandbox/org-comments/test/"*-test.el; do
    tests+=(-l "$test_file")
  done
  echo "Standalone ERT: org-comments + context-panels + Emacs built-ins only."
  emacs --batch "${args[@]}" --eval "$isolation" -l ert \
    "${tests[@]}" -f ert-run-tests-batch-and-exit
  echo "Strict byte compilation: warnings are errors."
  emacs --batch "${args[@]}" --eval "$isolation" \
    --eval '(setq byte-compile-error-on-warn t)' \
    -f batch-byte-compile "$sandbox/org-comments/"*.el
  echo "Standalone comments checks passed."
fi
