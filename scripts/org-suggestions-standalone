#!/usr/bin/env bash
# Exercise org-suggestions with only Emacs built-ins and its runnable example.
set -euo pipefail

mode=${1:---batch}
if [ "$#" -gt 1 ] || { [ "$mode" != --batch ] && [ "$mode" != --interactive ]; }; then
  echo "Usage: $0 [--batch|--interactive]" >&2
  exit 64
fi

repo_root=$(cd "$(dirname "$0")/.." && pwd)
package_root="$repo_root/packages/org-suggestions"
sandbox=$(mktemp -d "${TMPDIR:-/tmp}/org-suggestions-standalone.XXXXXX")
trap 'rm -rf "$sandbox"' EXIT
mkdir -p "$sandbox/org-suggestions/test" "$sandbox/org-suggestions/examples" "$sandbox/home"
cp "$package_root/"*.el "$sandbox/org-suggestions/"
cp "$package_root/test/"*-test.el "$sandbox/org-suggestions/test/"
cp "$package_root/examples/standalone.org" "$sandbox/org-suggestions/examples/"
cd "$sandbox"
export HOME="$sandbox/home"
export XDG_CONFIG_HOME="$HOME/.config" XDG_CACHE_HOME="$HOME/.cache" XDG_DATA_HOME="$HOME/.local/share"
unset EMACSLOADPATH EMACSNATIVELOADPATH

args=(-Q -L "$sandbox/org-suggestions")
isolation='(progn
  (dolist (library (quote ("hub-utils" "test-helpers" "hb-static-site"
                          "context-panels" "org-comments" "org-copilot"
                          "org-marginalia" "org-sync" "org-confluence" "org-google-docs")))
    (when (locate-library library)
      (error "Unexpected ambient library: %s" library)))
  (advice-add (quote make-network-process) :override
              (lambda (&rest _) (error "Standalone checks do not use the network"))))'

if [ "$mode" = --interactive ]; then
  echo "Temporary standalone session; files are removed when Emacs exits."
  echo "Evaluate each walkthrough block with C-c C-c, inspecting results before continuing."
  emacs "${args[@]}" --eval "$isolation" org-suggestions/examples/standalone.org \
    --eval '(progn (require (quote org-suggestions)) (require (quote ob-emacs-lisp)))'
else
  tests=()
  for test_file in "$sandbox/org-suggestions/test/"*-test.el; do
    tests+=(-l "$test_file")
  done
  echo "Standalone ERT: org-suggestions + Emacs built-ins only."
  emacs --batch "${args[@]}" --eval "$isolation" -l ert \
    "${tests[@]}" -f ert-run-tests-batch-and-exit
  echo "Strict byte compilation: warnings are errors."
  emacs --batch "${args[@]}" --eval "$isolation" \
    --eval '(setq byte-compile-error-on-warn t)' \
    -f batch-byte-compile "$sandbox/org-suggestions/"*.el
  echo "Standalone suggestions checks passed."
fi
