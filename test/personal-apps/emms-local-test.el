;;; emms-local-test.el --- Local backend registration regression tests -*- lexical-binding: t; -*-

;;; Commentary:
;; Exercise real EMMS dispatch without starting media players or reading credentials.

;;; Code:
(require 'ert)
(require 'cl-lib)
(dolist (package '("emms" "websocket" "compat"))
  (add-to-list 'load-path
	       (expand-file-name package (or (getenv "STRAIGHT_BUILD_PATH")
					     (expand-file-name "straight/build" default-directory)))))
(require 'apps/spotify-player)
(require 'apps/spotify-browser-player)
(require 'emms-playing-time)

(defmacro hub/emms-local-test--passive (&rest body)
  "Run BODY while forbidding playback, media probes, network and credentials."
  (declare (indent 0))
  `(cl-letf (((symbol-function 'executable-find) (lambda (name) (and (equal name "vlc") "/synthetic/vlc")))
	     ((symbol-function 'start-process) (lambda (&rest _) (ert-fail "Started a player or probe")))
	     ((symbol-function 'make-process) (lambda (&rest _) (ert-fail "Started a process")))
	     ((symbol-function 'auth-source-pass-get) (lambda (&rest _) (ert-fail "Read credentials")))
	     ((symbol-function 'url-retrieve) (lambda (&rest _) (ert-fail "Contacted the network"))))
     ,@body))

(ert-deftest hub/emms-local-spotify-only-registration-recovers-wav-dispatch ()
  "A Spotify-only runtime gains its configured VLC backend without losing Spotify."
  (let ((emms-player-list '(emms-player-spotify-browser))
	(emms-track-initialize-functions nil) (emms-cache-get-function nil)
	(emms-cache-set-function nil))
    (hub/emms-local-test--passive
     (hub/spotify-player-register)
     (should (eq (emms-player-for (emms-track 'file "/tmp/recording.wav")) 'emms-player-vlc))
     (should (eq (emms-player-for (emms-track 'url "spotify:track:4uLU6hMCjMI75M1A2tKUQC"))
		 'emms-player-spotify-browser)))))

(ert-deftest hub/emms-local-registration-order-is-idempotent-and-preserves-existing-players ()
  "Local-first and Spotify-first initialisation preserve dispatch and prior entries."
  (require 'apps/emms-local)
  (dolist (order '(local-first spotify-first))
    (let ((emms-player-list '(existing-custom-player)))
      (hub/emms-local-test--passive
       (if (eq order 'local-first)
	   (progn (hub/emms-register-local-players) (hub/spotify-player-register))
	 (hub/spotify-player-register) (hub/emms-register-local-players))
       (let ((before (copy-sequence emms-player-list)))
	 (dotimes (_ 3) (hub/emms-register-local-players) (hub/spotify-player-register))
	 (should (equal before emms-player-list))
	 (should (memq 'existing-custom-player emms-player-list))
	 (should (eq (car emms-player-list) 'emms-player-spotify-browser))
	 (should (< (cl-position 'emms-player-vlc emms-player-list)
		    (cl-position 'emms-player-mplayer emms-player-list))))))))

(ert-deftest hub/emms-local-registration-preserves-queue-and-transport-state ()
  "Registration cannot rewrite a queue, move selection, or stop the active player."
  (require 'apps/emms-local)
  (let* ((emms-player-list '(emms-player-spotify-browser))
	 (emms-playlist-buffer nil) (emms-playlist-buffers nil)
	 (emms-player-playing-p nil) (emms-player-paused-p t)
	 (emms-track-initialize-functions nil) (emms-cache-get-function nil)
	 (emms-cache-set-function nil)
	 (playlist (emms-playlist-new " *local registration queue*"))
	 (track (emms-track 'file "/tmp/recording.wav")))
    (unwind-protect
	(with-current-buffer playlist
	  (setq emms-playlist-buffer playlist)
	  (emms-playlist-insert-track track)
	  (emms-playlist-insert-track track)
	  (goto-char (point-min))
	  (emms-playlist-select (point))
	  (forward-line 1)
	  (let ((before (buffer-string)) (revision (buffer-chars-modified-tick))
		(where (point)) (selected (marker-position emms-playlist-selected-marker)))
	    (hub/emms-local-test--passive
	     (cl-letf (((symbol-function 'emms-start) (lambda (&rest _) (ert-fail "Started transport")))
		       ((symbol-function 'emms-stop) (lambda (&rest _) (ert-fail "Stopped transport"))))
	       (hub/emms-register-local-players)
	       (hub/spotify-player-register)))
	    (should (equal-including-properties before (buffer-string)))
	    (should (= revision (buffer-chars-modified-tick)))
	    (should (= where (point)))
	    (should (= selected (marker-position emms-playlist-selected-marker)))
	    (should (eq emms-playlist-buffer playlist))
	    (should-not emms-player-playing-p)
	    (should emms-player-paused-p)))
      (when (buffer-live-p playlist) (kill-buffer playlist)))))

(ert-deftest hub/emms-local-wav-duration-is-local-validated-and-does-not-rewrite-playlist ()
  "A missing WAV duration is read once and stored without changing occurrence identity."
  (require 'apps/emms-local)
  (let* ((file (make-temp-file "emms duration " nil ".WAV"))
	 (emms-track-initialize-functions nil) (emms-cache-get-function nil) (emms-cache-set-function nil)
	 (track (emms-track 'file file)) (emms-playlist-buffer nil) (emms-playlist-buffers nil)
	 (playlist (emms-playlist-new " *duration test*")) (calls 0))
    (unwind-protect
	(with-current-buffer playlist
	  (setq emms-playlist-buffer playlist)
	  (emms-playlist-insert-track track)
	  (goto-char (point-min)) (emms-playlist-select (point))
	  (let ((text (buffer-string)) (revision (buffer-chars-modified-tick))
		(where (point)) (selected (marker-position emms-playlist-selected-marker)))
	    (cl-letf (((symbol-function 'executable-find) (lambda (_) "/synthetic/ffprobe"))
		      ((symbol-function 'call-process)
		       (lambda (program _infile _destination _display &rest args)
			 (cl-incf calls)
			 (should (equal program "/synthetic/ffprobe"))
			 (should (member "-protocol_whitelist" args))
			 (should (member "file" args))
			 (should (member "wav" args))
			 (should (equal (car (last args)) file))
			 (insert "188.458662\n") 0)))
	      (hub/emms-local--read-duration track)
	      (hub/emms-local--read-duration track))
	    (should (= calls 1))
	    (should (= (emms-track-get track 'info-playing-time) 188))
	    (should (equal-including-properties text (buffer-string)))
	    (should (= revision (buffer-chars-modified-tick)))
	    (should (= where (point)))
	    (should (= selected (marker-position emms-playlist-selected-marker)))))
      (kill-buffer playlist)
      (delete-file file))))

(ert-deftest hub/emms-local-mp3-duration-uses-a-local-mp3-demuxer-once ()
  "Missing MP3 duration uses the start-time fallback, including mixed-case paths."
  (require 'apps/emms-local)
  (let* ((file (make-temp-file "emms [MP3 duration] " nil ".MP3"))
	 (emms-track-initialize-functions nil) (emms-cache-get-function nil) (emms-cache-set-function nil)
	 (track (emms-track 'file file)) (calls 0))
    (unwind-protect
	(cl-letf (((symbol-function 'executable-find) (lambda (_) "/synthetic/ffprobe"))
		  ((symbol-function 'call-process)
		   (lambda (_program _infile _destination _display &rest args)
		     (cl-incf calls)
		     (should (equal (cadr (member "-f" args)) "mp3"))
		     (should (equal (cadr (member "-protocol_whitelist" args)) "file"))
		     (should (equal (car (last args)) file))
		     (insert "125.255896\n") 0)))
	  (hub/emms-local--read-duration track)
	  (hub/emms-local--read-duration track)
	  (should (= calls 1))
	  (should (= (emms-track-get track 'info-playing-time) 125)))
      (delete-file file))))

(ert-deftest hub/emms-local-duration-skips-remote-url-other-formats-and-invalid-output ()
  "Only local WAV/MP3 are probed; failures leave metadata unknown and play intact."
  (require 'apps/emms-local)
  (let ((emms-track-initialize-functions nil) (emms-cache-get-function nil) (emms-cache-set-function nil))
    (cl-letf (((symbol-function 'call-process) (lambda (&rest _) (ert-fail "Ineligible file was probed")))
	      ((symbol-function 'file-regular-p) (lambda (_) (ert-fail "Ineligible file was inspected"))))
      (dolist (entry '((url . "spotify:track:4uLU6hMCjMI75M1A2tKUQC")
		       (url . "https://example.test/audio.wav")
		       (file . "/ssh:host:/audio.wav") (file . "/ssh:host:/audio.mp3")
		       (url . "https://example.test/audio.mp3") (file . "/tmp/audio.flac")))
	(hub/emms-local--read-duration (emms-track (car entry) (cdr entry)))))
    (let* ((file (make-temp-file "emms bad duration " nil ".wav"))
	   (track (emms-track 'file file)))
      (unwind-protect
	  (cl-letf (((symbol-function 'executable-find) (lambda (_) "/synthetic/ffprobe")))
	    (dolist (output '("N/A" "0.000000" "-1" "nan" "inf" "188junk"))
	      (cl-letf (((symbol-function 'call-process) (lambda (&rest _) (insert output) 0)))
		(hub/emms-local--read-duration track)
		(should-not (emms-track-get track 'info-playing-time))))
	    (cl-letf (((symbol-function 'call-process) (lambda (&rest _) (insert "188.0") 1)))
	      (hub/emms-local--read-duration track)
	      (should-not (emms-track-get track 'info-playing-time))))
	(delete-file file)))))

(ert-deftest hub/emms-local-clock-and-metadata-feed-the-native-player-snapshot ()
  "Start, native clock ticks, pause/resume, seek and stop drive the player inputs."
  (require 'apps/emms-local)
  (require 'apps/emms-player)
  (dolist (extension '(".wav" ".MP3"))
    (let* ((file (make-temp-file "emms clock " nil extension))
	   (emms-track-initialize-functions nil) (emms-cache-get-function nil) (emms-cache-set-function nil)
	   (track (emms-track 'file file)) (emms-playlist-buffer nil) (emms-playlist-buffers nil)
	   (playlist (emms-playlist-new " *local clock test*"))
	   (emms-player-list '(emms-player-vlc)) (emms-player-playing-p nil) (emms-player-paused-p nil)
	   (emms-player-delay 0) (emms-playing-time-mode nil)
	   (emms-playing-time 42) (emms-playing-time-display-mode nil)
	   (emms-playing-time-display-timer nil) (global-mode-string '("Existing"))
	   (emms-player-started-hook nil) (emms-player-stopped-hook nil) (emms-player-finished-hook nil)
	   (emms-player-paused-hook nil) (emms-player-seeked-functions nil) (emms-player-time-set-functions nil))
      (unwind-protect
	  (progn
	    (with-current-buffer playlist
	      (setq emms-playlist-buffer playlist)
	      (emms-playlist-insert-track track)
	      (goto-char (point-min)) (emms-playlist-select (point)))
	    (cl-letf (((symbol-function 'executable-find) (lambda (name) (concat "/synthetic/" name)))
		      ((symbol-function 'call-process) (lambda (&rest _) (insert "188.458662") 0))
		      ((symbol-function 'run-at-time) (lambda (&rest _) (timer-create)))
		      ((symbol-function 'emms-player-vlc-start) (lambda (_) (emms-player-started 'emms-player-vlc)))
		      ((symbol-function 'emms-player-vlc-stop) (lambda () (emms-player-stopped)))
		      ((symbol-function 'emms-player-vlc-pause) #'ignore)
		      ((symbol-function 'emms-player-vlc-seek) #'ignore))
	      (hub/emms-register-local-players)
	      (should emms-playing-time-mode)
	      (should (= emms-playing-time 42))
	      (should-not emms-playing-time-display-mode)
	      (should (equal global-mode-string '("Existing")))
	      (emms-start)
	      (should (= emms-playing-time 0))
	      (dotimes (_ 3) (emms-playing-time-display))
	      (should (= (plist-get (hub/emms-player--snapshot) :elapsed) 3))
	      (should (= (hub/emms-player--duration track) 188))
	      (emms-pause)
	      (should emms-player-paused-p)
	      (should-not emms-playing-time-display-timer)
	      (should (= emms-playing-time 3))
	      (emms-pause)
	      (should (timerp emms-playing-time-display-timer))
	      (emms-seek 30)
	      (should (= (plist-get (hub/emms-player--snapshot) :elapsed) 33))
	      (emms-stop)
	      (should-not emms-playing-time-display-timer)))
	(when (timerp emms-playing-time-display-timer) (cancel-timer emms-playing-time-display-timer))
	(setq emms-player-playing-p nil)
	(kill-buffer playlist)
	(delete-file file)))))

(provide 'emms-local-test)
;;; emms-local-test.el ends here
